# Noroff API v2 base URL — optional, defaults to the production API if unset.
VITE_API_BASE_URL=https://v2.api.noroff.dev

# Optional: a fixed Noroff API key. Leave blank — the app creates one
# automatically at login (POST /auth/create-api-key). Only set this if you
# prefer to reuse a single static key across sessions.
VITE_API_KEY=
